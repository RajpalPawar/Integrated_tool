# Copy this file to ".env" in the project root and replace EVERY value.
# ".env" is git-ignored and must never be committed or shared.
# Both the Spring Boot backend (when run with Maven) and docker-compose read this file.

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_DB=connect_projects
POSTGRES_USER=connect_projects
POSTGRES_PASSWORD=change-me-postgres-password
# Used by the backend. Keep identical to the two values above.
DATABASE_USERNAME=connect_projects
DATABASE_PASSWORD=change-me-database-password
# Only needed when running the backend with Maven (not Docker). Docker sets this itself.
DATABASE_URL=jdbc:postgresql://localhost:5432/connect_projects

# --- First Super User (created on first start only, if none exists) ------
BOOTSTRAP_SUPERUSER_USERNAME=superuser
# 12 to 72 characters. Change it after first login from Settings.
BOOTSTRAP_SUPERUSER_PASSWORD=change-me-superuser-password
BOOTSTRAP_SUPERUSER_NAME=Initial Super User
BOOTSTRAP_SUPERUSER_EMAIL=superuser@example.com

# --- Security ------------------------------------------------------------
# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-or-more-characters
# Separate 32-byte Base64 key for encrypted employee salary data.
# Generate with PowerShell: $b = New-Object byte[] 32; $r = [Security.Cryptography.RandomNumberGenerator]::Create(); $r.GetBytes($b); [Convert]::ToBase64String($b)
SALARY_ENCRYPTION_KEY=change-me-to-a-random-32-byte-base64-key
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_URL=http://localhost:5173

# --- Email (optional; needed for password reset and scheduled report e-mails)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
# For Gmail use an App Password, not your normal password.
MAIL_PASSWORD=
MAIL_FROM=




